PORT=3000

# MongoDB
MONGO_URI=mongodb://optimization-mongodb:27017/prompt-optimizer

# AI Providers
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=AI...
GEMINI_MODEL=gemini-2.5-flash

# Evaluation
EVALUATION_MAX_RETRIES=3
LLM_JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# This service's exchange (publishes here)
RMQ_PROMPT_EVALUATION_URL=amqp://admin:password@optimization-rabbitmq:5672
RMQ_PROMPT_EVALUATION_EXCHANGE_NAME=ex.prompt-evaluation.events
RMQ_PROMPT_EVALUATION_EXCHANGE_TYPE=direct

# Prompt Generation service (consumes from here)
RMQ_PROMPT_GENERATION_URL=amqp://admin:password@optimization-rabbitmq:5672
RMQ_PROMPT_GENERATION_EXCHANGE_NAME=ex.prompt-generation.events
RMQ_PROMPT_GENERATION_EXCHANGE_TYPE=direct
RMQ_PROMPT_GENERATION_QUEUE_NAME=q.prompt-evaluation.prompt-generation
RMQ_PROMPT_GENERATION_QUEUE_TYPE=quorum
